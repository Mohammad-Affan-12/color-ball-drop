; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[admob]

general/android/enabled=false
general/ios/enabled=false

[application]

config/name="Cut & Cascade: Ball Puzzle"
run/main_scene="res://scenes/main.tscn"
config/quit_on_go_back=false
config/features=PackedStringArray("4.7", "GL Compatibility")
run/max_fps=60
boot_splash/bg_color=Color(0.055, 0.094, 0.149, 1)
boot_splash/show_image=false
boot_splash/stretch_mode=0
boot_splash/use_filter=false
boot_splash/image="res://resources/icons/boot_splash.png"
config/icon="res://icon.svg"

[display]

window/size/viewport_width=720
window/size/viewport_height=1280
window/size/window_width_override=540
window/size/window_height_override=960
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"
window/handheld/orientation=1

[editor_plugins]

enabled=PackedStringArray("res://addons/admob/plugin.cfg")

[internationalization]

locale/translations=PackedStringArray("res://resources/i18n/ui.en.translation", "res://resources/i18n/ui.es.translation", "res://resources/i18n/ui.pt_BR.translation", "res://resources/i18n/ui.fr.translation", "res://resources/i18n/ui.de.translation", "res://resources/i18n/ui.id.translation")

[physics]

3d/physics_engine="Jolt Physics"

[release]

ads/enabled=false
ads/test_mode=true
ads/audience_reviewed=false
ads/under_age_of_consent=true
ads/child_directed=1
ads/rewarded_unit=""
ads/interstitial_unit=""
analytics/host=""
analytics/project_key=""
privacy_policy_url=""

[rendering]

rendering_device/driver.windows="d3d12"
renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
textures/vram_compression/import_etc2_astc=true
